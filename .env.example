# ============ 大肥鱼 AI 直播 配置 ============
# 复制本文件为 .env 后修改；.env 不要提交到仓库

# ---- 服务 ----
HOST=0.0.0.0
PORT=8848

# ---- 弹幕接入源 ----
# mock    : 本地模拟弹幕（开发/演示，无需登录）
# douyin  : 浏览器 CDP 采集（需要本机 Chrome/Edge）
# douyin_direct : 无浏览器直连（需要 Node 和 tools/douyin_sig）
# bridge  : 外部弹幕助手经 WebSocket 推送（DouyinBarrageGrab 等）
INGEST=bridge
# DEMO=true 可临时强制开启模拟弹幕，不改写保存的接入配置
DEMO=false

# 抖音直播间地址或房间号，如 https://live.douyin.com/123456789
DOUYIN_ROOM=            # 例如 123456789
DOUYIN_COOKIE=          # 可选，登录态可提高成功率

# bridge 模式下监听端口（助手推到这里）
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5001

# ---- 大脑 / LLM ----
# 留空则使用内置离线话术引擎（无需联网、无需 Key，可直接演示）
LLM_BASE_URL=           # 例：https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=              # 例：deepseek-chat / doubao-pro-32k
LLM_TEMPERATURE=0.85
LLM_MAX_TOKENS=220

# 人设（可自由改写）
PERSONA_NAME=大肥鱼
PERSONA_STYLE=嘴贫、爱吐槽、热心、偶尔自恋，喜欢用"鱼"相关梗

# ---- 语音 TTS ----
# edge : 微软 Edge 免费神经网络语音（默认，免费无需 Key）
TTS_ENGINE=edge
TTS_VOICE=zh-CN-XiaoyiNeural
TTS_RATE=+8%
TTS_VOLUME=+0%

# ---- 播报节奏 ----
# 一句话最少间隔（秒），避免刷屏
MIN_SPEAK_GAP=1.2
# 冷场多少秒后主动找话题
IDLE_CHAT_SECONDS=45
# 是否播报进场/关注/点赞
ANNOUNCE_ENTER=true
ANNOUNCE_LIKE=false
# 进场合并播报窗口（秒）
ENTER_MERGE_WINDOW=6
